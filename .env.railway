DB_PASSWORD=${PGPASSWORD}

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

